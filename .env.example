# Backend only. Loaded explicitly with uv run --env-file .env.
VERITY_DATA_DIR=.data
VERITY_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Empty key disables automated assessment. Never prefix secrets with VITE_.
VERITY_PROVIDER_FACTORY=verity.openrouter:create_provider
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ASSESSMENT_MODEL=nvidia/nemotron-3-nano-30b-a3b
OPENROUTER_RUBRIC_MODEL=nvidia/nemotron-3-nano-30b-a3b
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_TOKENS=8192

# A separate call produces student-safe coaching for validated findings.
OPENROUTER_FEEDBACK_MODEL=nvidia/nemotron-3-nano-30b-a3b

# Reserved: the PDF vision pipeline is not implemented yet.
OPENROUTER_PARSING_MODEL=nvidia/nemotron-nano-12b-v2-vl
